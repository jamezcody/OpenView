{
  "name": "openview",
  "version": "0.1.3",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "node scripts/copy-cesium.mjs",
    "dev": "vinext dev --port 4000",
    "data:build": "node scripts/build-data-release.mjs",
    "data:install": "node scripts/install-data.mjs",
    "prebuild": "node scripts/clean-dist.mjs && node scripts/copy-cesium.mjs",
    "build": "vinext build",
    "runtime:build": "node scripts/build-runtime-archive.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/copy-cesium.mjs",
    "test": "node scripts/run-tests.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "security:audit": "node scripts/audit-credentials.mjs",
    "security:audit:generated": "node scripts/audit-credentials.mjs --generated dist",
    "lint": "oxlint app components hooks lib scripts tests",
    "format": "oxfmt",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@mapbox/vector-tile": "^3.0.0",
    "cesium": "1.145.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "linkedom": "^0.18.13",
    "lucide-react": "1.31.0",
    "pbf": "^5.1.2",
    "pmtiles": "^4.5.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "satellite.js": "6.0.2",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
